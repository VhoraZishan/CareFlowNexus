# ============================================
# CareFlow Nexus AI Agents Configuration
# ============================================
# Copy this file to .env and fill in your values
# DO NOT commit .env file to version control!

# ============================================
# Firebase Configuration
# ============================================
# Path to your Firebase service account JSON file
FIREBASE_SERVICE_ACCOUNT_PATH=./config/serviceAccountKey.json

# Firebase Realtime Database URL (optional)
# Format: https://your-project-id.firebaseio.com
FIREBASE_DATABASE_URL=https://your-project-id.firebaseio.com

# ============================================
# Google Gemini AI Configuration
# ============================================
# Get your API key from: https://ai.google.dev
GOOGLE_API_KEY=your_gemini_api_key_here

# Gemini model to use
# Options: gemini-2.0-flash-exp, gemini-1.5-flash, gemini-1.5-pro
GEMINI_MODEL=gemini-2.0-flash-exp

# Temperature for AI responses (0.0 = deterministic, 1.0 = creative)
GEMINI_TEMPERATURE=0.5

# Maximum tokens in AI response
GEMINI_MAX_TOKENS=2048

# ============================================
# Agent Configuration
# ============================================
# State refresh interval for Memory Agent (seconds)
AGENT_REFRESH_INTERVAL=300

# Hybrid AI weights (must sum to 1.0)
# RULE_WEIGHT: Weight for rule-based scoring (0.0 - 1.0)
# AI_WEIGHT: Weight for AI-based scoring (0.0 - 1.0)
RULE_WEIGHT=0.5
AI_WEIGHT=0.5

# Allocation confidence threshold (0-100)
# Recommendations below this threshold will trigger warnings
ALLOCATION_CONFIDENCE_THRESHOLD=70

# Maximum tasks per staff member
MAX_STAFF_WORKLOAD=5

# Task monitoring intervals (seconds)
TASK_CHECK_INTERVAL=60
TASK_TIMEOUT_WARNING=1800
TASK_TIMEOUT_CRITICAL=3600

# ============================================
# Server Configuration
# ============================================
# Port for the agent HTTP server
AGENT_SERVER_PORT=9000

# ============================================
# System Configuration
# ============================================
# Environment: development, staging, production
ENVIRONMENT=development

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ============================================
# Example Configuration
# ============================================
# FIREBASE_SERVICE_ACCOUNT_PATH=./config/serviceAccountKey.json
# FIREBASE_DATABASE_URL=https://careflow-nexus.firebaseio.com
# GOOGLE_API_KEY=AIzaSyAbCdEfGhIjKlMnOpQrStUvWxYz1234567
# GEMINI_MODEL=gemini-2.0-flash-exp
# GEMINI_TEMPERATURE=0.5
# GEMINI_MAX_TOKENS=2048
# AGENT_REFRESH_INTERVAL=300
# RULE_WEIGHT=0.5
# AI_WEIGHT=0.5
# ALLOCATION_CONFIDENCE_THRESHOLD=70
# MAX_STAFF_WORKLOAD=5
# TASK_CHECK_INTERVAL=60
# TASK_TIMEOUT_WARNING=1800
# TASK_TIMEOUT_CRITICAL=3600
# AGENT_SERVER_PORT=9000
# ENVIRONMENT=development
# LOG_LEVEL=INFO
