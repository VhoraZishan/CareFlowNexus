# CareFlow Nexus Backend Environment Variables

# ============================================================================
# Agent Service URLs
# ============================================================================
# Bed allocation agent endpoint
BED_AGENT_URL=https://careflownexusagents.onrender.com/agent/bed-assignment

# Cleaner assignment agent endpoint
CLEANER_AGENT_URL=https://careflownexusagents.onrender.com/agent/cleaner-assignment

# Nurse assignment agent endpoint
NURSE_AGENT_URL=https://careflownexusagents.onrender.com/agent/nurse-assignment

# ============================================================================
# Firebase Configuration
# ============================================================================
# Path to Firebase service account JSON file
# On Render, upload serviceAccountKey.json as a Secret File
FIREBASE_CRED_PATH=/etc/secrets/serviceAccountKey.json

# Firebase Realtime Database URL (optional)
FIREBASE_DATABASE_URL=https://your-project.firebaseio.com

# ============================================================================
# Local Development Overrides
# ============================================================================
# Uncomment these for local development:
# BED_AGENT_URL=http://localhost:9000/agent/bed-assignment
# CLEANER_AGENT_URL=http://localhost:9000/agent/cleaner-assignment
# NURSE_AGENT_URL=http://localhost:9000/agent/nurse-assignment
# FIREBASE_CRED_PATH=./config/serviceAccountKey.json
