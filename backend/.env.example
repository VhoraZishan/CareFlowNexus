# ============================================
# CareFlow Nexus Backend Configuration
# ============================================
# Copy this file to .env and fill in your values
# DO NOT commit .env file to version control!

# ============================================
# Firebase Configuration
# ============================================
# Path to your Firebase service account JSON file
# This should be the SAME file used by the agents
FIREBASE_CRED_PATH=./config/serviceAccountKey.json

# ============================================
# AI Agent Service URLs
# ============================================
# These URLs point to the Agent Server endpoints
# Make sure the Agent Server is running before starting the backend

# Bed Assignment Agent endpoint
BED_AGENT_URL=http://localhost:9000/agent/bed-assignment

# Cleaner Assignment Agent endpoint
CLEANER_AGENT_URL=http://localhost:9000/agent/cleaner-assignment

# Nurse Assignment Agent endpoint
NURSE_AGENT_URL=http://localhost:9000/agent/nurse-assignment

# ============================================
# Server Configuration
# ============================================
# Backend server host and port
HOST=0.0.0.0
PORT=8000

# ============================================
# Security Configuration (for future use)
# ============================================
# JWT secret key for token generation
# JWT_SECRET_KEY=your_secret_key_here

# Token expiration time (in minutes)
# JWT_EXPIRATION_MINUTES=60

# ============================================
# CORS Configuration
# ============================================
# Allowed origins for CORS (comma-separated)
# In development, you can use "*" for all origins
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ============================================
# Example Configuration
# ============================================
# FIREBASE_CRED_PATH=./config/serviceAccountKey.json
# BED_AGENT_URL=http://localhost:9000/agent/bed-assignment
# CLEANER_AGENT_URL=http://localhost:9000/agent/cleaner-assignment
# NURSE_AGENT_URL=http://localhost:9000/agent/nurse-assignment
# HOST=0.0.0.0
# PORT=8000
